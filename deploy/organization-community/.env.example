# Copy to .env.production.local. Never commit the real file.
# Build this repository's custom image. Stock upstream images omit directory/matrix changes.
TEABLE_IMAGE=teable-organization:1.0.0
# Examples aligned with this repository's PostgreSQL 15 / Redis 7 compose setup.
# Resolve and record reviewed image digests before the production rollout.
POSTGRES_IMAGE=postgres:15
REDIS_IMAGE=redis:7-alpine
POSTGRES_DB=teable_production
POSTGRES_USER=teable
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
PUBLIC_ORIGIN=https://teable.example.com
SECRET_KEY=REPLACE_WITH_RANDOM_HEX
BACKEND_JWT_SECRET=REPLACE_WITH_RANDOM_HEX
BACKEND_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX
BACKEND_THIRD_PARTY_CREDENTIAL_ENCRYPTION_SECRET=REPLACE_WITH_RANDOM_HEX
BACKEND_AI_CONFIG_ENCRYPTION_SECRET=REPLACE_WITH_RANDOM_HEX
BACKEND_ENV_VARIABLE_SECRET=REPLACE_WITH_RANDOM_HEX
# These legacy AES consumers require exactly 16 ASCII bytes, not 32-byte hex strings.
BACKEND_STORAGE_ENCRYPTION_KEY=REPLACE_16_BYTES
BACKEND_STORAGE_ENCRYPTION_IV=REPLACE_16_BYTES
BACKEND_ACCESS_TOKEN_ENCRYPTION_KEY=REPLACE_16_BYTES
BACKEND_ACCESS_TOKEN_ENCRYPTION_IV=REPLACE_16_BYTES
BACKEND_MAIL_ENCRYPTION_KEY=REPLACE_16_BYTES
BACKEND_MAIL_ENCRYPTION_IV=REPLACE_16_BYTES
